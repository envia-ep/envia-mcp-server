# ── stdio mode ────────────────────────────────────────────────────────────────
# Envia API token (required for stdio / single-user mode)
# Get your key from Desarrolladores → Acceso de API in your dashboard:
#   Sandbox:    https://shipping-test.envia.com/settings/developers
#   Production: https://shipping.envia.com/settings/developers
ENVIA_API_KEY=your_jwt_token_here

# Environment: "sandbox" (default) or "production"
ENVIA_ENVIRONMENT=sandbox

# ── HTTP / OAuth mode ─────────────────────────────────────────────────────────
# MCP transport: "http" (OAuth) or "stdio" (API key). Defaults to "http".
MCP_TRANSPORT=http

# Public URL of THIS MCP server — used in OAuth discovery metadata.
# Required when MCP_TRANSPORT=http.
OAUTH_SERVER_URL=https://mcp.envia.com

# Queries API base URL (OAuth issuer). Same var as queries / envia-clients.
# Production: https://queries.envia.com  |  Sandbox: https://queries-test.envia.com
ENVIA_QUERIES_HOSTNAME=https://queries.envia.com

# HS256 signing key shared with the queries API (= JWT_KEY in queries).
# Required when MCP_TRANSPORT=http.
OAUTH_JWT_KEY=your_shared_jwt_key_here
