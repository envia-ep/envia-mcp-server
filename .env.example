# ── stdio mode ────────────────────────────────────────────────────────────────
# Envia API token (required for stdio / single-user mode)
# Get your key from Desarrolladores → Acceso de API in your dashboard:
#   Sandbox:    https://shipping-test.envia.com/settings/developers
#   Production: https://shipping.envia.com/settings/developers
ENVIA_API_KEY=your_jwt_token_here

# Environment: "sandbox" (default) or "production"
ENVIA_ENVIRONMENT=sandbox

# ── HTTP / OAuth mode ─────────────────────────────────────────────────────────
# MCP transport: "http" (OAuth) or "stdio" (API key). Defaults to "http".
MCP_TRANSPORT=http

# Public URL of THIS MCP server — used in OAuth discovery metadata and as JWT aud.
# Must match the origin you open in the browser (chat demo is at /).
# Local loopback: http://127.0.0.1:3000  — do not use http://localhost (queries rejects it).
# Required when MCP_TRANSPORT=http. Must match PORT (default 3000).
OAUTH_SERVER_URL=http://127.0.0.1:3000

# Queries API base URL (OAuth issuer). Same var as queries / envia-clients.
# Production: https://queries.envia.com  |  Stage: https://queries-test.envia.com
ENVIA_QUERIES_HOSTNAME=https://queries-test.envia.com

# HS256 signing key shared with the queries API (= JWT_KEY on that queries env).
# Required when MCP_TRANSPORT=http.
OAUTH_JWT_KEY=your_shared_jwt_key_here

# Tool calls that carry the OAuth JWT must hit the same env the token was issued for.
# Stage / queries-test → sandbox. Leave unset only for local stdio without an override key.
ENVIA_ENVIRONMENT=sandbox

# HTTP issuer URLs other than 127.0.0.1 / localhost need this flag (MCP SDK check).
# MCP_DANGEROUSLY_ALLOW_INSECURE_ISSUER_URL=true
